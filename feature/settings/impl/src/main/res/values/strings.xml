    <string name="settings_privacy_title">Privacy and data</string>
    <string name="settings_privacy_local">Sample transactions and saved budgets stay in app storage on this phone. There\'s no account or analytics.</string>
    <string name="settings_privacy_cloud"><b>Cloud AI</b> sends your question, the selected month and category totals to the AI provider over HTTPS. Individual transactions and budgets are never sent.</string>
    <string name="settings_privacy_on_device"><b>On-device AI</b> sends nothing; the only network use is the model download. The conversation is cleared when the app closes.</string>
    <string name="settings_about_title">About this project</string>
    <string name="settings_about_body">PesaLens is an educational Android portfolio app built with Kotlin, Jetpack Compose and Room. It isn\'t a bank or a financial adviser, and it doesn\'t connect to M-Pesa or any account. Version 1.0.</string>

    <string name="settings_clear_dialog_title">Clear conversation?</string>
    <string name="settings_clear_dialog_body">Messages and results in this session will be removed. Saved budgets aren\'t affected.</string>
    <string name="settings_clear_dialog_cancel">Cancel</string>
    <string name="settings_clear_dialog_confirm">Clear</string>
    <string name="settings_reset_dialog_title">Reset sample data?</string>
    <string name="settings_reset_dialog_body">This restores the original sample transactions. <b>Saved budgets and any sample-data changes will be permanently deleted</b>, and the conversation will be cleared.</string>
